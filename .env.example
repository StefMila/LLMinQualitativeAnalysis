# Copia questo file in .env e inserisci chiavi ed endpoint. .env non va mai condiviso.

# Azure OpenAI (togli OPENAI_BASE_URL per usare api.openai.com)
OPENAI_API_KEY=...
OPENAI_BASE_URL=https://<risorsa>.services.ai.azure.com/openai/v1

# Claude su Azure AI Foundry (senza /v1 finale)
ANTHROPIC_FOUNDRY_API_KEY=...
ANTHROPIC_FOUNDRY_BASE_URL=https://<risorsa>.services.ai.azure.com/anthropic
